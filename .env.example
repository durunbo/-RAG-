# ==========================================================
# RAG 微服务配置示例
# 用法：cp .env.example .env 后按需修改
# 所有变量统一 RAG_ 前缀（由 app/core/config.py 的 env_prefix 决定）
# 完整说明见 app/core/config.py
# ==========================================================

# ---------- 一、LLM（与 Embedding 独立选择） ----------
# ollama | openai_compatible
# 开发期用 ollama（本机已验证）；上线前改 openai_compatible 即可切云端，
# 业务代码不需要改。
RAG_LLM_PROVIDER=ollama

# ollama          -> http://127.0.0.1:11434
# DeepSeek        -> https://api.deepseek.com
# 通义千问兼容模式 -> https://dashscope.aliyuncs.com/compatible-mode/v1
# Docker 部署时用 http://host.docker.internal:11434
RAG_LLM_BASE_URL=http://127.0.0.1:11434

# 本机可选：qwen2.5:7b / deepseek-r1:14b
# 云端可选：deepseek-chat / qwen-plus 等
# 注意 deepseek-reasoner 不接受 temperature，要用它得先去 config 里处理该参数
RAG_LLM_MODEL=qwen2.5:7b

# 云端必填；provider=ollama 时留空。
# 真实 key 只写进 .env（已被 .gitignore 忽略），不要提交到本文件。
RAG_LLM_API_KEY=

RAG_LLM_TIMEOUT_SECONDS=180
RAG_LLM_TEMPERATURE=0.2
RAG_LLM_MAX_TOKENS=400
RAG_LLM_MAX_CONCURRENCY=3

# ---------- 二、Embedding ----------
# local（当前唯一已实现）。接云端时需要在 config 与 embedding_client 工厂里补分支
RAG_EMBEDDING_PROVIDER=local
RAG_EMBEDDING_MODEL=bge-m3
# 必须是本机已存在的目录。不支持 BAAI/bge-m3 这类 HuggingFace 标识
# （那种写法会联网下载，离线环境必定失败）；目录不存在则服务启动即报错
RAG_EMBEDDING_MODEL_PATH=
# cpu | cuda | mps
RAG_EMBEDDING_DEVICE=cpu
RAG_EMBEDDING_BATCH_SIZE=32

# ---------- 三、数据库 ----------
# 不写就用 config.py 里的本地默认值。
# 下面只是占位符，不是真实凭据；真实密码只写进 .env
# RAG_DATABASE_URL=postgresql+asyncpg://rag_user:<your-password>@localhost:5432/rag_db

# ---------- 四、检索（RAG）策略 ----------
# 检索片段的最低相似度（1 - 余弦距离，越大越相似）。0 = 不过滤，保持原行为。
# 建议先留 0 跑一段时间，从日志里看真实分数分布再定阈值；
# 实测相关片段约 0.65~0.70，设到 0.6 以上容易把「表述不同但内容正确」的丢掉。
RAG_RETRIEVAL_MIN_SCORE=0

# ---------- 五、认证与限流 ----------
# 测试阶段用模拟 Token 认证：token 精确匹配表，不做解析、验签或 Claims 校验。
# 身份来源：调用方在请求头携带 Authorization: Bearer <token>，
# 本服务不签发凭据、也不维护用户名录，只做精确匹配。

# 认证实现。当前唯一取值 mock；接入真实 Token 解析库后在这里加取值。
RAG_AUTH_PROVIDER=mock

# 模拟 token 表，格式 "token1:user_001,token2:user_002"（逗号分隔，
# 冒号前是 token、冒号后是 user_id）。
# 留空会导致服务启动失败——这是刻意的：
# 认证配不齐时宁可起不来，也不要让一个「谁都没有身份」的服务静默对外。
# 注意：生产环境（RAG_APP_ENV=production）禁止 mock，启动会直接失败；
# 上线前必须接入真实 Token 解析并改掉这里的取值。
RAG_MOCK_TOKENS=test-token-user-001:user_001,test-token-user-002:user_002

# 每个用户每分钟允许的请求数。0 = 关闭限流（仅本地调试）。
# 与 RAG_LLM_MAX_CONCURRENCY 不冲突：那个限「同时几个」，这个限「一分钟共几个」。
# 注意本限流是进程内内存实现，多副本部署时实际放行量 = 配置值 × 副本数。
RAG_RATE_LIMIT_PER_MINUTE=20

# ---------- 六、调用方怎么带 token ----------
#   Authorization: Bearer <token>
# 查询当前身份：GET /api/v1/auth/me（不计入每分钟额度）
#
# 测试阶段的 token 即 RAG_MOCK_TOKENS 里的字符串，服务端只做精确匹配，
# 没有「签发」环节，也没有 api_keys 表。
# 接入真实 Token 解析后，token 由公司登录系统签发、本服务只验证；
# 那时不要再把任何用户的 token 写进环境变量——那会变成所有人共用同一身份，
# 会话归属隔离直接失效。RAG_MOCK_TOKENS 只是测试期的临时对照表。

# ---------- 七、文档管理（仅管理员） ----------
# 允许使用上传 / 查询进度 / 删除的 user_id，逗号分隔。
# 留空 = 功能整体关闭（三个接口按「不存在」返回 404），服务仍正常启动。
# 前端靠 GET /api/v1/auth/me 返回的 is_admin 决定是否渲染上传、删除入口。
RAG_ADMIN_USER_IDS=user_001

# 允许的扩展名；.doc 是旧二进制格式，解析器不支持
RAG_UPLOAD_ALLOWED_EXTENSIONS=.pdf,.docx

# 单文件大小上限（字节）。20971520 = 20 MB
RAG_UPLOAD_MAX_BYTES=20971520

# 上传临时目录（相对项目根目录）。任务结束即删；
# 进程被强杀残留的，启动时按 1 小时清理
RAG_UPLOAD_TEMP_DIR=data/uploads

# 任务记录保留时长（分钟）与条数上限。
# 任务表在进程内存里，因此本服务**只能单进程运行**：
# 加 --workers N 会导致上传落到 A 进程、轮询落到 B 进程，表现为「传了查不到」
RAG_INGEST_TASK_TTL_MINUTES=60
RAG_INGEST_TASK_MAX_RECORDS=200

